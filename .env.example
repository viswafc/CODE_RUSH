# Environment
DATABASE_URL=sqlite:///./code_rush.db
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin (dev only - change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Code Runner
CODE_EXECUTION_TIMEOUT=10
CODE_MEMORY_LIMIT_MB=256

# Competition
ROUND1_DURATION_MINUTES=15
ROUND2_DURATION_MINUTES=30
ROUND2_POINTS_PER_PROBLEM=10

# CORS
FRONTEND_URL=http://localhost:5173
